JSP896.independentTransversal_of_degree_lt_threshold (r n : ℕ) (hr : 2 ≤ r) (hn : 0 < n)
  (G : SimpleGraph (JSP896.Vertex r n)) (hpart : JSP896.IsPartite G)
  (hdegree : ∀ (v : JSP896.Vertex r n), JSP896.degree G v < JSP896.independentThreshold r n) :
  JSP896.HasIndependentTransversal G
JSP896.transversalClique_of_degree_gt_threshold (r n : ℕ) (hr : 2 ≤ r) (hn : 0 < n)
  (G : SimpleGraph (JSP896.Vertex r n)) (hpart : JSP896.IsPartite G)
  (hdegree : ∀ (v : JSP896.Vertex r n), JSP896.cliqueThreshold r n < JSP896.degree G v) : JSP896.HasTransversalClique G
JSP896.exists_independent_sharpness_at_threshold (r n : ℕ) (hr : 2 ≤ r) (hn : 0 < n) :
  ∃ G,
    JSP896.IsPartite G ∧
      (∀ (v : JSP896.Vertex r n), JSP896.degree G v ≤ JSP896.independentThreshold r n) ∧
        ¬JSP896.HasIndependentTransversal G
JSP896.exists_sharpness_at_threshold (r n : ℕ) (hr : 2 ≤ r) (hn : 0 < n) :
  ∃ G,
    JSP896.IsPartite G ∧
      (∀ (v : JSP896.Vertex r n), JSP896.cliqueThreshold r n ≤ JSP896.degree G v) ∧ ¬JSP896.HasTransversalClique G
JSP896.full_resolution : JSP896.FullResolution
JSP896.full_resolution_with_original_limits :
  JSP896.FullResolution ∧
    (∀ (r : ℕ),
        2 ≤ r →
          Filter.Tendsto (fun n => ↑(JSP896.independentThreshold r n) / ↑n) Filter.atTop
              (nhds (JSP896.independentCoefficient r)) ∧
            Filter.Tendsto (fun n => ↑(JSP896.cliqueThreshold r n) / ↑n) Filter.atTop
              (nhds (JSP896.cliqueCoefficient r))) ∧
      Filter.Tendsto JSP896.independentCoefficient Filter.atTop (nhds (1 / 2)) ∧
        Filter.Tendsto (fun r => ↑(r - 1) - JSP896.cliqueCoefficient r) Filter.atTop (nhds (1 / 2))
