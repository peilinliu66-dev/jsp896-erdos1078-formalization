'audit_literal_large_r_independent_limit' depends on axioms: [propext, Classical.choice, Quot.sound]
'audit_literal_original_BES_large_r_limit' depends on axioms: [propext, Classical.choice, Quot.sound]
'JSP896.full_resolution_with_original_limits' depends on axioms: [propext, Classical.choice, Quot.sound]
